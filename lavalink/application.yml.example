### Lavalink v4 node configuration for Alfred.
###
### Copy to `lavalink/application.yml` and fill in the credentials.
###
### Plugin versions verified 2026-08-14 against the projects' tags. They rot — YouTube
### playback in particular is an ongoing cat-and-mouse, and youtube-source ships fixes for it
### faster than anything else here. Check before deploying:
###   https://github.com/lavalink-devs/youtube-source/releases
###   https://github.com/topi314/LavaSrc/releases
###   https://github.com/topi314/LavaSearch/releases

server:
  port: 2333
  address: 0.0.0.0

lavalink:
  plugins:
    - dependency: "dev.lavalink.youtube:youtube-plugin:1.18.2"
      repository: "https://maven.lavalink.dev/releases"
    - dependency: "com.github.topi314.lavasrc:lavasrc-plugin:4.8.3"
      repository: "https://maven.lavalink.dev/releases"
    # Powers the rich (artist/album/playlist) results behind `/search` autocomplete.
    - dependency: "com.github.topi314.lavasearch:lavasearch-plugin:1.0.0"
      repository: "https://maven.lavalink.dev/releases"

  server:
    password: "youshallnotpass"
    sources:
      # YouTube is served by the youtube-plugin below, not by Lavalink's built-in source.
      youtube: false
      bandcamp: false
      soundcloud: true
      twitch: false
      vimeo: false
      http: true
      local: false
    filters:
      # The bot applies no filters, so all of these stay off. Turning equalizer and
      # timescale on is what an /effects command would need.
      equalizer: false
      timescale: false
      volume: false
      karaoke: false
      tremolo: false
      vibrato: false
      distortion: false
      rotation: false
      channelMix: false
      lowPass: false
    bufferDurationMs: 400
    frameBufferDurationMs: 5000
    opusEncodingQuality: 10
    resamplingQuality: LOW
    trackStuckThresholdMs: 10000
    useSeekGhosting: true
    youtubePlaylistLoadLimit: 6
    playerUpdateInterval: 5
    youtubeSearchEnabled: true
    soundcloudSearchEnabled: true
    gc-warnings: true

plugins:
  youtube:
    enabled: true
    allowSearch: true
    allowDirectVideoIds: true
    allowDirectPlaylistIds: true
    # Queried in order, so put the clients that work best for you first. `MUSIC` is what makes
    # `ytmsearch:` work and has no playback support, so it earns its place at the top only
    # because search hits it; the eight below it are the ones that can actually stream.
    #
    # Do not copy a client list from an older config: the set changes. `TVHTML5EMBEDDED`, which
    # the legacy bot led with, is no longer a valid client name at all.
    #
    # WEB and WEBEMBEDDED lead because they are the only two a `pot.token` applies to, and on a
    # VPS that token is the difference between playing and not. Left further down, the node
    # works through six clients that YouTube has already decided to refuse before reaching the
    # two that carry the credential.
    clients:
      - MUSIC
      - WEB
      - WEBEMBEDDED
      - TVHTML5_SIMPLY
      - TV
      - IOS
      - MWEB
      - ANDROID_VR

    # REQUIRED. Without this, every client above fails and nothing plays - verified here on
    # 2026-08-15, on youtube-source 1.18.2, the current release:
    #
    #   TVHTML5_SIMPLY  Sign in to confirm you're not a bot
    #   TVHTML5         Must find sig function from script: /s/player/b0d2d49a/...
    #   IOS             Invalid status code for player api response: 400
    #   MWEB            Must find sig function from script: /s/player/b0d2d49a/...
    #   ANDROID_VR      This video requires login.
    #   WEB             No supported audio streams available, available types:
    #   WEB_EMBEDDED    Video player configuration error
    #
    # YouTube hands out an obfuscated JS player that has to be run to turn a stream signature
    # into a playable URL; the plugin's own extractor cannot keep up with it. yt-cipher runs
    # the script properly and answers over HTTP. The maintainer's answer on youtube-source#225
    # is that this is the supported fix, not a release to wait for.
    #   https://github.com/kikkia/yt-cipher
    #
    # `docker compose up` runs one as the `yt-cipher` service, which is what this points at.
    # Running the node on its own instead (scripts/lavalink.ps1)? Either start that service
    # with `docker compose up yt-cipher`, or - for a laptop, not for a deployment - borrow the
    # author's public instance, which needs no password and is rate limited to 10 req/s across
    # everyone using it:
    #
    #   url: "https://cipher.kikkia.dev"
    #   userAgent: "alfred"
    #
    # `${CIPHER_PASSWORD}` is resolved by Spring from the node's environment, so the password
    # lives in .env next to the bot's, not in this file.
    remoteCipher:
      url: "http://yt-cipher:8001"
      password: "${CIPHER_PASSWORD}"
      userAgent: "alfred"

    # The cipher server above solves the signature errors. It does not solve
    # "sign in to confirm you're not a bot", which is YouTube objecting to the IP rather than
    # to the request. That is what these two are for, and you want exactly one of them —
    # never both.
    #
    # poToken: applies only to WEB and WEBEMBEDDED, which is why they lead the client list.
    #   https://github.com/lavalink-devs/youtube-source#using-a-potoken
    #
    # Generate it on the machine that will be playing, not on a laptop and then copied up.
    # The token vouches for a session on the IP it was issued to, and one minted at home is
    # being handed to YouTube from a datacentre, which is the thing it was meant to answer:
    #
    #   docker run --rm quay.io/invidious/youtube-trusted-session-generator
    #
    # Prints `visitor_data` and `po_token`. Both go below; `docker compose restart lavalink`
    # picks them up, since this file is a bind mount rather than baked into the image.
    #
    # They expire - days to weeks. When every YouTube track starts failing again with
    # "sign in to confirm you're not a bot", regenerate rather than looking for what broke.
    pot:
      token: ""
      visitorData: ""

    # OAuth: works more broadly, but authenticates as a real account. Use a burner — the
    # upstream warning is that a terminated account is a possible outcome, and that it can
    # trigger rate limits on a busy node.
    #   https://github.com/lavalink-devs/youtube-source#using-oauth-tokens
    # oauth:
    #   enabled: true
    #   refreshToken: ""   # printed to the node's log after the first successful flow

  lavasrc:
    providers:
      - "ytsearch:\"%ISRC%\""
      - "dzisrc:%ISRC%"
      - "ytsearch:%QUERY%"
    sources:
      spotify: true
      # Verified against LavaSrc 4.8.3: leaving this `true` with an empty
      # masterDecryptionKey below kills the node at startup, before it binds a port -
      # `IllegalArgumentException: Deezer master key must be set`, thrown from the
      # plugin's constructor. Fill both Deezer fields in, or set this to `false`.
      #
      # Spotify is not like this: it registers with empty credentials and fails per
      # request instead, which `/search` already handles by returning no results.
      #
      # Off by default for that reason: this file is copied and started before it is read.
      # Turn it on in the same edit that fills in the two fields below.
      deezer: false
      applemusic: false
      yandexmusic: false
      flowerytts: false
      youtube: false
    spotify:
      clientId: ""
      clientSecret: ""
      countryCode: "US"
      playlistLoadLimit: 6
      albumLoadLimit: 6
    deezer:
      masterDecryptionKey: ""
      # Required as of LavaSrc 4.x — Deezer will not resolve without it, whatever the
      # decryption key says.
      arl: ""

metrics:
  prometheus:
    enabled: false
    endpoint: /metrics

logging:
  file:
    path: ./logs

  # The legacy config had this on with `includePayload: true`, which logs a line per REST call
  # including the body - and the body of a voice update is the guild's Discord voice token and
  # session id, in plaintext, in a file kept for 30 days. It was also most of the node's output.
  #
  # Turn `enabled` back on temporarily to see what the bot sends the node; leave
  # `includePayload` off unless the payload is what you are debugging.
  request:
    enabled: false
    includeClientInfo: true
    includeHeaders: false
    includeQueryString: true
    includePayload: false
    maxPayloadLength: 10000

  # Spring and Undertow have nothing to say that is worth reading at INFO. Lavalink's own
  # loggers stay there, so track loading, node state and playback errors still show up.
  level:
    root: WARN
    lavalink: INFO
    com.github.topi314: INFO
    dev.lavalink.youtube: INFO

  logback:
    rollingpolicy:
      max-file-size: 1GB
      max-history: 30
