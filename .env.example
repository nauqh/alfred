# Required - your Discord bot token
DISCORD_TOKEN=

# Lavalink node. The defaults match the node in docker-compose.yml, where `lavalink` is
# the service name on the compose network. Running the bot on the host instead - against
# `scripts/lavalink.ps1` or `docker compose up lavalink` - needs 127.0.0.1.
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_REGION=asia
LAVALINK_SSL=false
LAVALINK_NODE_NAME=default-node

# Optional - JSON array of node objects, for more than one node.
# LAVALINK_NODES=[{"name": "primary", "region": "asia"}, {"name": "backup", "host": "10.0.0.4"}]

# Optional - register commands to these guilds instead of globally, for instant updates.
# DEFAULT_GUILDS=123456789012345678

# Required by docker-compose: the password the Lavalink node uses to reach the yt-cipher
# service, which is what makes YouTube playback work at all. Any random string - both sides
# read it from here. Not needed when the node borrows the public cipher instance instead.
CIPHER_PASSWORD=

# Optional - answering @mentions with a chat model, via OpenRouter. Leave the key blank and
# the listener is never registered, so the bot stays deaf to ordinary messages.
# Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model ids ending in `:free` are rotated by OpenRouter and a retired one 404s at request
# time, not at startup. Current list: https://openrouter.ai/models?q=free
#
# Prefer a non-reasoning model. A reasoning model spends seconds thinking before its first
# word - measured here on 2026-08-23, nemotron-3.5-lightning took 5-29s a reply against
# 1.7-5.8s for the default below, and leaked its thinking into the channel now and then.
# OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
# Reasoning models spend most of this budget thinking before they write a word, so this is
# far larger than the sentence-or-two reply it has to fit. Too low and answers are cut off.
# CHAT_MAX_TOKENS=1200
# CHAT_TEMPERATURE=0.7
# CHAT_TIMEOUT=30
# Replaces Alfred's built-in persona and its knowledge of its own commands, wholesale.
# CHAT_SYSTEM_PROMPT=

# Optional
DELETE_AFTER=60
LOG_LEVEL=INFO
# LOG_DIR=logs

# Optional - the channel (ID) Alfred posts its newest dev log to on restart. Leave unset
# and restarts are silent (no log is posted). To find an ID: Discord settings -> advanced ->
# developer mode, then right-click the channel -> copy channel ID.
# STARTUP_CHANNEL_ID=
